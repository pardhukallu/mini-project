PROJECT_NAME="ShadowWatch"
VERSION="1.0.0"
ENVIRONMENT="development"
SECRET_KEY="replace-with-a-long-random-secret-before-deployment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL="sqlite+aiosqlite:///./shadowwatch.db"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GEMINI_API_KEY=""

# Email-existence verification (breach data cannot confirm a mailbox exists).
# "smtp" (default) probes the recipient mail server directly: free, no key.
# Optional paid providers: abstract, hunter, zerobounce (requires a key).
EMAIL_VERIFICATION_PROVIDER="smtp"
EMAIL_VERIFICATION_API_KEY=""
EMAIL_VERIFICATION_TIMEOUT_SECONDS=10
